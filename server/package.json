    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "mongodb-memory-server": "^10.1.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
