{
  "name": "syncplay-server",
  "version": "1.0.0",
  "description": "SyncPlay Backend Server with real-time video synchronization and chat",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
