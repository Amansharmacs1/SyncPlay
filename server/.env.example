PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/syncplay

# CORS & Client Origins
# Set to * to allow any deployed frontend, or specify comma-separated domains:
# e.g. CLIENT_URL=https://syncplay.vercel.app
# e.g. CORS_ORIGIN=https://syncplay.vercel.app,https://mycustomdomain.com
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=*
